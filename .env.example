# No environment variables are required for the local MapLibre coordinate canvas.

# Server-only key used by /api/explain-farm. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: where the SQLite file lives. Default: data/runtime/plantae.sqlite (and /tmp/plantae.sqlite on Vercel, where the disk is temporary).
# PLANTAE_DB_PATH=/var/lib/plantae/plantae.sqlite
